#!/usr/bin/env bash
# claude-remote — launch a remote-controlled Claude session with a derived label.
#
# Adopted verbatim from the `claude-remote()` bash function in ~/.bashrc
# (Hydra machine-level harness). This is Step 0.1 of the #583 harness split:
# bringing a homeless machine-level piece into the versioned repo, faithful-first.
# Staleness fixes (making the ~/.hydra-sandbox marker name configurable) are a
# follow-up, tracked separately — the body below is a faithful lift-and-shift.
#
# Usage: claude-remote [label] [-m|--model MODEL] [-b|--bypass] [-- claude args...]
set -uo pipefail

claude-remote() {
  local default_label
  if [ -n "$TMUX" ]; then
    default_label=$(tmux display-message -p '#S')
  elif git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local repo branch common_dir
    common_dir=$(git rev-parse --git-common-dir 2>/dev/null)
    case "$common_dir" in
      /*) ;;
      *) common_dir="$PWD/$common_dir" ;;
    esac
    # For a bare repo (e.g. hydra.git) the repo name is the parent of the
    # common dir. For a normal .git repo it's the parent of .git, which is
    # also the parent of the common dir, so one rule handles both.
    repo=$(basename "$(dirname "$common_dir")")
    branch=$(git branch --show-current 2>/dev/null)
    [ -z "$branch" ] && branch=$(git rev-parse --short HEAD 2>/dev/null)
    default_label="${repo}-${branch}"
  else
    default_label="$(basename "$(dirname "$PWD")")/$(basename "$PWD")"
  fi
  # First positional arg (if present and not a flag) overrides the label; the
  # rest are forwarded to `claude` so callers can pass --continue, --resume, etc.
  local label
  if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
    label="$1"
    shift
  else
    label="$default_label"
  fi
  # Parse leading -m/--model and -b/--bypass flags; remaining args forwarded to claude.
  # -b/--bypass passes --dangerously-skip-permissions (for sandboxed worktrees).
  local model="opus"
  local bypass=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -m|--model)
        if [ $# -lt 2 ]; then
          echo "claude-remote: $1 requires a model name (e.g. opus, sonnet, opusplan)" >&2
          return 1
        fi
        model="$2"
        shift 2
        ;;
      --model=*)
        model="${1#--model=}"
        shift
        ;;
      -b|--bypass)
        bypass="--dangerously-skip-permissions"
        shift
        ;;
      *)
        break
        ;;
    esac
  done
  # Sandbox auto-bypass: on a machine that declares itself a Hydra sandbox
  # (marker file ~/.hydra-sandbox present), default to --dangerously-skip-permissions
  # so agents never stall on permission prompts. On a non-sandbox machine (no marker,
  # e.g. a laptop) this stays off and normal prompting applies. An explicit -b still
  # forces it anywhere. See claude/sandbox-permissions.md in the Hydra repo.
  if [ -z "$bypass" ] && [ -f "$HOME/.hydra-sandbox" ]; then
    bypass="--dangerously-skip-permissions"
  fi
  echo -ne "\033]0;Claude: $label\007"
  CLAUDE_LABEL="$label" claude --remote-control "$label" --model "$model" $bypass "$@"
}

claude-remote "$@"
