#!/usr/bin/env bash
# claude-remote — launch a remote-controlled Claude session with a derived label.
#
# Adopted verbatim from the `claude-remote()` bash function in ~/.bashrc
# (Hydra machine-level harness). This is Step 0.1 of the #583 harness split:
# bringing a homeless machine-level piece into the versioned repo, faithful-first.
# Staleness fixes (making the ~/.hydra-sandbox marker name configurable) are a
# follow-up, tracked separately — the body below is a faithful lift-and-shift.
#
# Usage: claude-remote [label] [-m|--model MODEL] [-b|--bypass] [-n|--name NAME] [-- claude args...]
#
# Session name (the address other sessions use with SendMessage; see
# docs/cross-worktree-messages.md): -n/--name NAME, else the label. Inside tmux the
# label defaults to the tmux session name, which is unique per machine and carries
# the project prefix (hydra-agents#1), so spawned and recovered agents get a stable,
# unique, project-qualified name. Without --name, Claude Code would derive one from
# the working directory plus a random suffix, ignoring the --remote-control label.
#
# A `--` ends claude-remote's own options and is consumed here. Everything after it
# goes to `claude` as options: forwarding the `--` itself made `claude` treat the
# rest as the initial prompt (a `-- --name X` launch sent the prompt "--name" and
# left the session with its auto name). hydra-agents#7.
set -uo pipefail

claude-remote() {
  local default_label
  if [ -n "$TMUX" ]; then
    default_label=$(tmux display-message -p '#S')
  elif git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    local repo branch common_dir
    common_dir=$(git rev-parse --git-common-dir 2>/dev/null)
    case "$common_dir" in
      /*) ;;
      *) common_dir="$PWD/$common_dir" ;;
    esac
    # For a bare repo (e.g. hydra.git) the repo name is the parent of the
    # common dir. For a normal .git repo it's the parent of .git, which is
    # also the parent of the common dir, so one rule handles both.
    repo=$(basename "$(dirname "$common_dir")")
    # A submodule's common dir is <superproject git dir>/modules/<name>: the repo
    # name is the submodule's, not "modules".
    [ "$repo" = "modules" ] && repo=$(basename "$common_dir")
    branch=$(git branch --show-current 2>/dev/null)
    [ -z "$branch" ] && branch=$(git rev-parse --short HEAD 2>/dev/null)
    default_label="${repo}-${branch}"
  else
    default_label="$(basename "$(dirname "$PWD")")/$(basename "$PWD")"
  fi
  # First positional arg (if present and not a flag) overrides the label; the
  # rest are forwarded to `claude` so callers can pass --continue, --resume, etc.
  local label
  if [ $# -gt 0 ] && [ "${1#-}" = "$1" ]; then
    label="$1"
    shift
  else
    label="$default_label"
  fi
  # Parse leading -m/--model, -b/--bypass and -n/--name flags; remaining args forwarded to claude.
  # -b/--bypass passes --dangerously-skip-permissions (for sandboxed worktrees).
  local model="opus"
  local bypass=""
  local name=""
  while [ $# -gt 0 ]; do
    case "$1" in
      -m|--model)
        if [ $# -lt 2 ]; then
          echo "claude-remote: $1 requires a model name (e.g. opus, sonnet, opusplan)" >&2
          return 1
        fi
        model="$2"
        shift 2
        ;;
      --model=*)
        model="${1#--model=}"
        shift
        ;;
      -b|--bypass)
        bypass="--dangerously-skip-permissions"
        shift
        ;;
      -n|--name)
        if [ $# -lt 2 ]; then
          echo "claude-remote: $1 requires a session name" >&2
          return 1
        fi
        name="$2"
        shift 2
        ;;
      --name=*)
        name="${1#--name=}"
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done
  # Name the session explicitly so its address is deterministic: -n/--name, else
  # the label. A --name forwarded to claude (e.g. after `--`) wins over both.
  local a name_args=(--name "${name:-$label}")
  for a in "$@"; do
    case "$a" in
      -n|--name|--name=*) name_args=(); break ;;
    esac
  done
  # Sandbox auto-bypass: on a machine that declares itself a Hydra sandbox
  # (marker file ~/.hydra-sandbox present), default to --dangerously-skip-permissions
  # so agents never stall on permission prompts. On a non-sandbox machine (no marker,
  # e.g. a laptop) this stays off and normal prompting applies. An explicit -b still
  # forces it anywhere. See claude/sandbox-permissions.md in the Hydra repo.
  if [ -z "$bypass" ] && [ -f "$HOME/.hydra-sandbox" ]; then
    bypass="--dangerously-skip-permissions"
  fi
  echo -ne "\033]0;Claude: $label\007"
  # Opt out of Claude Code's low-memory background-shell reaper: it kills agents' queued build
  # waits (work that never started), and the build-lane wrapper already gates starts on memory
  # headroom. It only takes effect if set at launch (Josh, Desk card 53, 2026-11-06).
  CLAUDE_LABEL="$label" CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP=1 \
    claude --remote-control "$label" ${name_args[@]+"${name_args[@]}"} --model "$model" $bypass "$@"
}

claude-remote "$@"
